require "shellwords"
require "bundler"

default_platform(:android)

PLAY_KEY = "secrets/play-key.json"
PACKAGE  = "com.safar.safar"
TRACK    = "first"

platform :android do
  desc "Pull the current Play listing into fastlane/metadata/android/"
  lane :pull do
    supply(
      json_key: PLAY_KEY,
      package_name: PACKAGE,
      action: "init",
    )
  end

  desc "Push listing assets (icon, feature graphic, screenshots, text). Never touches the AAB or release notes."
  lane :listing do
    supply(
      json_key: PLAY_KEY,
      package_name: PACKAGE,
      track: TRACK,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Push only the icon + feature graphic. Leaves screenshots and text alone."
  lane :icon do
    supply(
      json_key: PLAY_KEY,
      package_name: PACKAGE,
      track: TRACK,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: true,
      skip_upload_screenshots: true,
    )
  end

  # ── Production promotion ──────────────────────────────────────────────────
  # Promote the build already live on the closed "first" track UP to Production
  # without rebuilding — same AAB, same versionCode, no new upload. Run locally,
  # same as the listing lanes (Homebrew Ruby + secrets/play-key.json present):
  #
  #   bundle exec fastlane android promote_to_production                  # 10% staged rollout (default)
  #   bundle exec fastlane android promote_to_production rollout:1.0      # full (100%) rollout
  #   bundle exec fastlane android promote_to_production status:draft     # stage a Production DRAFT to publish by hand in Console
  #   bundle exec fastlane android promote_to_production version_code:18  # pin a specific build (default: whatever is on "first")
  #
  # Preconditions, independent of this lane:
  #   1. The service account has the "Release to production" permission.
  #   2. Production is unlocked for the app — personal Play accounts must finish
  #      the closed-testing requirement (>=12 testers, >=14 days) first; until
  #      then the promotion is rejected no matter the config.
  desc "Promote the current 'first'-track build to Production (no rebuild). Defaults to a 10% staged rollout."
  lane :promote_to_production do |options|
    status = options[:status] || "inProgress"

    params = {
      json_key: PLAY_KEY,
      package_name: PACKAGE,
      track: TRACK,
      track_promote_to: "production",
      track_promote_release_status: status,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    }
    # rollout only applies to a staged (inProgress) rollout; omit it for draft/completed.
    params[:rollout] = (options[:rollout] || "0.1") if status == "inProgress"
    params[:version_code] = options[:version_code].to_i if options[:version_code]

    supply(params)
  end
end

# ── iOS / TestFlight ─────────────────────────────────────────────────────────
# One-command TestFlight upload. Mirrors the Android release invocation
# (obfuscated + dart-define-from-file=config.json) for build parity.
#
#   bundle exec fastlane ios beta
#   bundle exec fastlane ios beta build_number:36  # override CFBundleVersion for an iOS-only rebuild
#
# Requires at the repo root (all gitignored):
#   • config.json                — the same dart-defines the app runs with
#   • secrets/AuthKey_<KeyID>.p8  — the ASC API key, kept under Apple's own name
#                                   (the Key ID is read from the filename)
#   • ASC Issuer ID (a UUID) via env ASC_ISSUER_ID OR secrets/asc_issuer_id.txt
#     — from ASC → Users & Access → Integrations, top of the page
#
# One-time account-side prerequisites this lane does NOT do:
#   1. Paid-program agreements signed & Active in App Store Connect.
#   2. App record for com.nalbusaidi.rihla created in App Store Connect.
#   3. Personal Apple ID (team T2U886CPS5) added to Xcode (automatic signing).
#   4. APNs Auth Key uploaded to Firebase Console (turns on iOS FCM push).

# ASC API key resolution shared by all iOS lanes. Apple downloads the key as
# AuthKey_<KeyID>.p8 — keep that name in secrets/ and the Key ID comes from the
# filename. Issuer ID (a UUID) via env ASC_ISSUER_ID or secrets/asc_issuer_id.txt.
def asc_api_key(root)
  keys = Dir.glob(File.join(root, "secrets", "AuthKey_*.p8"))
  UI.user_error!("Put the ASC API key (AuthKey_<KeyID>.p8) in secrets/.") if keys.empty?
  UI.user_error!("Multiple AuthKey_*.p8 in secrets/ — keep only one.") if keys.length > 1
  key_path = keys.first
  key_id   = File.basename(key_path, ".p8").sub("AuthKey_", "")

  issuer_file = File.join(root, "secrets", "asc_issuer_id.txt")
  issuer_id = ENV["ASC_ISSUER_ID"]
  issuer_id ||= File.read(issuer_file).strip if File.exist?(issuer_file)
  UI.user_error!("Set ASC_ISSUER_ID or write it to secrets/asc_issuer_id.txt.") if issuer_id.to_s.empty?

  app_store_connect_api_key(
    key_id:       key_id,
    issuer_id:    issuer_id,
    key_filepath: key_path,
    in_house:     false,
  )
end

# Resolve the three Sentry symbol-upload vars. ENV wins; a gitignored
# secrets/sentry.env (simple `KEY=VALUE` lines) is the local fallback. Parsed in
# Ruby — never shell-sourced — so the auth token never lands in shell history or
# a command log. Returns a hash keyed by var name; a value is nil when unresolved.
def sentry_upload_env(root)
  wanted = %w[SENTRY_AUTH_TOKEN SENTRY_ORG SENTRY_PROJECT]
  resolved = {}
  wanted.each { |k| resolved[k] = ENV[k] unless ENV[k].to_s.strip.empty? }

  env_file = File.join(root, "secrets", "sentry.env")
  if File.exist?(env_file)
    File.foreach(env_file) do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")
      key, sep, value = line.partition("=")
      next if sep.empty?
      key = key.strip
      next unless wanted.include?(key)
      value = value.strip
      # Strip one pair of surrounding quotes if the user wrote KEY="value".
      if value.length >= 2 &&
         ((value.start_with?('"') && value.end_with?('"')) ||
          (value.start_with?("'") && value.end_with?("'")))
        value = value[1..-2]
      end
      resolved[key] ||= value unless value.empty?  # ENV already set wins.
    end
  end
  resolved
end

# Upload iOS debug symbols (native xcarchive dSYMs + Dart split-debug-info
# symbols) to Sentry via `dart run sentry_dart_plugin`, using the pubspec
# `sentry:` config. Warn-not-block end to end: called AFTER upload_to_testflight
# so a Sentry failure can never block the release, and every failure path only
# warns. The three vars are passed through the child-process ENV, NEVER
# interpolated into the command string (that would echo the token into
# fastlane's command log). Mirrors the Android CI step in release_android.yml.
def upload_ios_symbols_to_sentry(root)
  env = sentry_upload_env(root)
  missing = %w[SENTRY_AUTH_TOKEN SENTRY_ORG SENTRY_PROJECT].select { |k| env[k].to_s.empty? }
  unless missing.empty?
    UI.important(
      "Sentry symbol upload skipped — #{missing.join(', ')} unresolved " \
      "(checked ENV, then secrets/sentry.env). iOS dSYMs and Dart debug " \
      "symbols will NOT be uploaded, so prod crash frames stay unsymbolicated. " \
      "Set SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT in the environment " \
      "or in secrets/sentry.env (see #950/#933)."
    )
    return
  end

  begin
    # with_unbundled_env snapshots ENV on entry and fully restores it on exit,
    # so the vars we set here are inherited by the `dart run` child yet never
    # leak past this block. The command string carries no secret.
    Bundler.with_unbundled_env do
      ENV["SENTRY_AUTH_TOKEN"] = env["SENTRY_AUTH_TOKEN"]
      ENV["SENTRY_ORG"]        = env["SENTRY_ORG"]
      ENV["SENTRY_PROJECT"]    = env["SENTRY_PROJECT"]
      sh("cd #{root.shellescape} && dart run sentry_dart_plugin")
    end
    UI.success("Uploaded iOS symbols to Sentry.")
  rescue => e
    UI.error(
      "Sentry symbol upload failed (non-blocking; the TestFlight upload " \
      "already succeeded): #{e.message}"
    )
  end
end

platform :ios do
  desc "Build an obfuscated release IPA and upload it to TestFlight (ASC API-key auth)."
  lane :beta do |options|
    root = File.expand_path("..", __dir__)
    build_number = options[:build_number]
    unless build_number.nil?
      UI.user_error!("build_number must be a positive integer.") unless build_number.to_s.match?(/\A[1-9]\d*\z/)
    end
    build_number_arg = build_number.nil? ? "" : " --build-number=#{build_number}"
    api_key = asc_api_key(root)

    # Run the Flutter build (and the `pod install` it triggers) OUTSIDE Bundler's
    # environment. Under `bundle exec fastlane`, Bundler's GEM_HOME/RUBYOPT leak
    # into the subprocess and Homebrew CocoaPods loads "broken" → pod install is
    # skipped and the archive fails in seconds.
    Bundler.with_unbundled_env do
      sh("cd #{root.shellescape} && flutter build ipa --release " \
         "--obfuscate --split-debug-info=build/ios/symbols " \
         "--dart-define-from-file=config.json " \
         "--export-options-plist=ios/ExportOptions.plist#{build_number_arg}")
    end

    ipa = Dir.glob(File.join(root, "build", "ios", "ipa", "*.ipa")).max_by { |f| File.mtime(f) }
    UI.user_error!("No IPA produced under build/ios/ipa/.") unless ipa

    upload_to_testflight(
      api_key:                            api_key,
      ipa:                                ipa,
      skip_waiting_for_build_processing:  true,
      skip_submission:                    true,
    )

    # Upload symbols LAST — after the TestFlight upload — so a Sentry failure can
    # never block the release. Warn-not-block; sweeps the xcarchive dSYMs and the
    # --split-debug-info Dart symbols. See upload_ios_symbols_to_sentry.
    upload_ios_symbols_to_sentry(root)
  end

  # Push the App Store listing text (name, subtitle, description, keywords,
  # promo text, URLs, categories) to App Store Connect. Same ASC API key as
  # `beta`. Never uploads a binary, never submits for review, never touches
  # screenshots (iOS needs 6.7"/6.5" captures we don't generate here).
  #
  #   bundle exec fastlane ios metadata
  #
  # Text lives in fastlane/metadata/ios/ (deliver layout), kept separate from
  # the Android supply tree at fastlane/metadata/android/.
  desc "Push the App Store listing text to App Store Connect (no binary, no submit, no screenshots)."
  lane :metadata do
    root = File.expand_path("..", __dir__)
    upload_to_app_store(
      api_key:                 asc_api_key(root),
      app_identifier:          "com.nalbusaidi.rihla",
      metadata_path:           File.join(root, "fastlane", "metadata", "ios"),
      skip_binary_upload:      true,
      skip_screenshots:        true,
      skip_metadata:           false,
      submit_for_review:       false,
      run_precheck_before_submit: false,
      force:                   true,
      precheck_include_in_app_purchases: false,
    )
  end

  # Push App Store screenshots from fastlane/screenshots/<locale>/. deliver maps
  # each PNG to a device by its pixel dimensions (1284x2778 → 6.5" iPhone,
  # 2048x2732 → 13" iPad). No binary, no metadata, no submit.
  #
  #   bundle exec fastlane ios screenshots
  desc "Push App Store screenshots to App Store Connect (no binary, no metadata, no submit)."
  lane :screenshots do
    root = File.expand_path("..", __dir__)
    upload_to_app_store(
      api_key:                 asc_api_key(root),
      app_identifier:          "com.nalbusaidi.rihla",
      screenshots_path:        File.join(root, "fastlane", "screenshots"),
      metadata_path:           File.join(root, "fastlane", "metadata", "ios"),
      skip_binary_upload:      true,
      skip_metadata:           true,
      skip_screenshots:        false,
      overwrite_screenshots:   true,
      submit_for_review:       false,
      run_precheck_before_submit: false,
      force:                   true,
    )
  end

  # CI twin of `beta` for headless macOS runners (release_ios.yml): no Xcode
  # account exists there, so signing is MANUAL via fastlane match — setup_ci
  # makes a throwaway keychain, match installs the CI distribution cert +
  # "match AppStore com.nalbusaidi.rihla" profile (encrypted in the private
  # rihla-ios-certs repo; MATCH_PASSWORD decrypts), and
  # update_code_signing_settings flips the RUNNER's project copy to manual
  # before the build (never committed). Build then mirrors `beta` but with
  # ios/ExportOptionsCI.plist (manual) instead of ExportOptions.plist
  # (automatic). Env contract (materialized by the workflow): config.json,
  # ios/Runner/GoogleService-Info.plist, secrets/AuthKey_<KeyID>.p8,
  # ASC_ISSUER_ID, MATCH_PASSWORD, SSH auth for MATCH_GIT_URL, SENTRY_*.
  desc "CI: build + upload to TestFlight with match-managed manual signing (no Xcode account)."
  lane :ci_beta do
    root = File.expand_path("..", __dir__)
    api_key = asc_api_key(root)
    setup_ci
    match(type: "appstore", readonly: true, api_key: api_key)
    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["com.nalbusaidi.rihla"]
    UI.user_error!("match returned no profile for com.nalbusaidi.rihla") if profile_name.to_s.empty?
    update_code_signing_settings(
      path:                  File.join(root, "ios", "Runner.xcodeproj"),
      use_automatic_signing: false,
      team_id:               "T2U886CPS5",
      targets:               ["Runner"],
      bundle_identifier:     "com.nalbusaidi.rihla",
      code_sign_identity:    "Apple Distribution",
      profile_name:          profile_name,
    )

    Bundler.with_unbundled_env do
      sh("cd #{root.shellescape} && flutter build ipa --release " \
         "--obfuscate --split-debug-info=build/ios/symbols " \
         "--dart-define-from-file=config.json " \
         "--export-options-plist=ios/ExportOptionsCI.plist")
    end

    ipa = Dir.glob(File.join(root, "build", "ios", "ipa", "*.ipa")).max_by { |f| File.mtime(f) }
    UI.user_error!("No IPA produced under build/ios/ipa/.") unless ipa

    upload_to_testflight(
      api_key:                            api_key,
      ipa:                                ipa,
      skip_waiting_for_build_processing:  true,
      skip_submission:                    true,
    )

    upload_ios_symbols_to_sentry(root)
  end

  # Submit an ALREADY-UPLOADED TestFlight build to App Store review — the prod
  # half of the release: `ios beta` uploads the binary, this selects it,
  # pushes metadata (update release_notes.txt for the version FIRST), and
  # submits. No binary upload, no screenshots. Releases automatically on
  # approval (pass automatic_release:false to hold for a manual release).
  #
  #   bundle exec fastlane ios release version:1.9.2 build_number:38
  #
  # submission_information answers the submit-time questionnaire: no IDFA (no
  # ads SDK), no non-exempt encryption (matches ITSAppUsesNonExemptEncryption
  # in Info.plist).
  desc "Submit an uploaded TestFlight build to App Store review (no binary upload)."
  lane :release do |options|
    UI.user_error!("Pass version:X.Y.Z (the App Store version to create/submit).") if options[:version].to_s.empty?
    UI.user_error!("Pass build_number:N (an already-uploaded build).") if options[:build_number].to_s.empty?
    root = File.expand_path("..", __dir__)
    upload_to_app_store(
      api_key:                 asc_api_key(root),
      app_identifier:          "com.nalbusaidi.rihla",
      app_version:             options[:version].to_s,
      build_number:            options[:build_number].to_s,
      metadata_path:           File.join(root, "fastlane", "metadata", "ios"),
      skip_binary_upload:      true,
      skip_screenshots:        true,
      skip_metadata:           false,
      submit_for_review:       true,
      automatic_release:       options[:automatic_release].nil? ? true : options[:automatic_release],
      run_precheck_before_submit: false,
      force:                   true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
  end
end
