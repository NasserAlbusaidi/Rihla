// Phase 38 (INFRA-01) — deny-all on trip buckets.
//
// All reads and writes to trip-documents/*, trip-memories/*, and receipts/*
// are gated by Cloud Functions callables that issue short-lived signed URLs
// after re-verifying group membership. Direct client SDK access (including
// FirebaseStorage.instance.ref(...).putFile / getDownloadURL / delete) is
// denied unconditionally — see functions/test/storage-rules.test.ts for
// the four-pattern denial proof.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Trip documents: deny all direct client access.
    match /trip-documents/{eventId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Trip memories (photos): same treatment.
    match /trip-memories/{eventId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Receipts: same treatment.
    match /receipts/{eventId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Default: deny all other paths.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
