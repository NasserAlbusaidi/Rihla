rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Join threat model: invite codes and throttling counters are server-only.
    // Clients create invite lookup docs only while creating their own groups;
    // all reads and group membership writes for joins go through the
    // joinGroupByInviteCode callable, which uses the Admin SDK and bypasses
    // these rules.

    function signedIn() {
      return request.auth != null;
    }

    function nullableString(value) {
      return value == null || value is string;
    }

    // #194 - bounded, control-char-free free text (expense description/note/
    // categoryId/receiptUrl/subGroupId and settlement note). '*' (not '+') so
    // empty string stays allowed; <= 280 chars; rejects \x00-\x1f and \x7f
    // (same charset as isValidDisplayName). Enforced in the create/update
    // WRAPPERS (diff-gated on update), never in the shared base validators, so
    // legacy >280 / control-char docs stay soft-deletable — the bases keep the
    // type-only nullableString check.
    function validFreeText(value) {
      return value == null
        || (value is string
          && value.size() <= 280
          && value.matches('^[^\\x00-\\x1f\\x7f]*$'));
    }

    // E1 - display-name validation.
    //
    // Accepts non-empty strings between 1 and 32 chars (inclusive). Rejects
    // control characters (\x00-\x1F and \x7F) which can be used for injection
    // or to confuse downstream rendering. Whitespace-only strings are rejected
    // via the trimmed-length check.
    function isValidDisplayName(s) {
      return s is string
        && s.size() >= 1
        && s.size() <= 32
        && s.trim().size() >= 1
        && s.matches('^[^\\x00-\\x1f\\x7f]+$')
        && !s.matches('.* \\(former member\\)$');
    }

    function isValidNullableDisplayName(s) {
      return s == null || isValidDisplayName(s);
    }

    // Firestore Rules has no map-value loop. This validates every map value by
    // joining values with a separator that is first forbidden inside each value.
    function displayNameMapValuesAreValid(names) {
      return names is map
        && names.size() > 0
        && names.values().join('').matches('^[^\\x00-\\x1f\\x7f]+$')
        && names.values().join('\n').matches('^[^\\n]{1,32}(\\n[^\\n]{1,32})*$')
        && names.values().join('\n').matches('^[^\\n]*[^\\n ][^\\n]*(\\n[^\\n]*[^\\n ][^\\n]*)*$')
        && !names.values().join('\n').matches('(^|.*\\n)[^\\n]* \\(former member\\)(\\n.*|$)');
    }

    // #193 - currency must be one of the codes MoneySerializer can scale
    // (lib/core/services/money_serializer.dart). Tightening this shared
    // predicate also constrains expense create/update and group create/metadata
    // to the same allow-list — intended and consistent; the app only ever
    // writes these UPPERCASE codes. Drops the old size()==3 check (all entries
    // are 3 chars). Rejects unsupported (e.g. 'XYZ') and lowercase codes whose
    // read path would otherwise throw ArgumentError in MoneySerializer.
    function validCurrency(value) {
      return value is string
        && value in ['OMR', 'USD', 'EUR', 'GBP', 'SAR', 'AED', 'JPY', 'KWD', 'BHD', 'QAR'];
    }

    // #287 (trip-stamps): a group's optional decorative "stamp". `glyph` is an
    // allow-listed enum string (the 12 ship-with icons); `inkIndex` is the ink
    // colour swatch 0..5. Both are nullable-by-absence on the model — these
    // helpers are STRICT (key must be ABSENT or a valid value). An explicit null
    // is neither, so it is rejected; clearing a stamp uses a field-DELETE
    // (post-write key absent), which the `!('glyph' in data)` guards admit.
    // Mirrored by the Dart model + picker (GroupGlyph) and PR-2b/PR-3.
    function validGlyph(value) {
      return value is string && value in [
        'tent', 'mountain', 'palm', 'sun', 'wave', 'compass',
        'anchor', 'house', 'dining', 'coffee', 'gift', 'camera'
      ];
    }
    function validInkIndex(value) {
      return value is int && value >= 0 && value <= 5;
    }

    function positiveInt(value) {
      // #528: cap at Number.MAX_SAFE_INTEGER (2^53-1). Above it, an amountFils
      // stored as a Dart int64 reads back as a divergent JS number server-side,
      // breaking the balance oracle's byte-for-byte parity. Backstops a forged
      // Dart/Admin write; the app's MoneySerializer.fitsSafeSubunits guards the
      // normal client path. Mirrored by that constant.
      return value is int && value > 0 && value <= 9007199254740991;
    }

    // Settlement predicates shared by event-scope and group-scope settlements
    // (#48). The scope-specific shape — allowed keys, doc/parent-id binding,
    // participant set, scope literal, and group display names — stays in the
    // per-scope validators below; only these scope-agnostic field checks live here.
    function validSettlementCore(data) {
      return data.createdBy is string
        && data.createdBy.size() > 0
        && data.payerParticipantId != data.recipientParticipantId
        && positiveInt(data.amountFils)
        && validCurrency(data.currency)
        && nullableString(data.note)
        && data.isDeleted is bool
        && (data.deletedAt == null || data.deletedAt is string)
        && data.settledAt is string
        // #752 group-settle-up link. OPTIONAL — the client OMITS the key when
        // null (it is not written as explicit null), so this MUST use the
        // `!('x' in data) ||` guard. A direct `data.groupSettleUpId == ...`
        // access on the absent key would deny EVERY keyless settlement write
        // (i.e. all existing settle-ups), since this core runs on every create.
        // #889: tightened from a bare `is string` — a blank/whitespace-only
        // value is denied so it isn't normalized three different ways by
        // rules, model code, and history grouping. `.matches()` is a
        // FULL-STRING RE2 match (rules has no `trim()`), so this checks for a
        // non-space char ANYWHERE in the string, not a substring "contains."
        && (!('groupSettleUpId' in data)
          || (data.groupSettleUpId is string && data.groupSettleUpId.matches('.*[^ ].*')));
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function groupData(groupId) {
      return get(groupPath(groupId)).data;
    }

    function groupAfterData(groupId) {
      return getAfter(groupPath(groupId)).data;
    }

    function groupAllowsClientWrites(groupId) {
      return exists(groupPath(groupId))
        && (!groupData(groupId).keys().hasAny(['isDeleted'])
          || groupData(groupId).isDeleted == false)
        && (!groupData(groupId).keys().hasAny(['deletingInProgress'])
          || groupData(groupId).deletingInProgress == false)
        && (!groupData(groupId).keys().hasAny(['claimingInProgress'])
          || groupData(groupId).claimingInProgress == false)
        && (!groupData(groupId).keys().hasAny(['accountDeletionInProgress'])
          || groupData(groupId).accountDeletionInProgress == false);
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(groupPath(groupId))
        && request.auth.uid in groupData(groupId).memberIds;
    }

    function isGroupCreator(groupId) {
      return signedIn()
        && exists(groupPath(groupId))
        && request.auth.uid == groupData(groupId).createdBy;
    }

    // #874: a member/event doc created in the SAME atomic batch as its brand-new
    // group. isGroupMember/groupAllowsClientWrites read BEFORE-batch state (the
    // group does not exist yet -> they short-circuit false), so the founding
    // batch is validated against after-state here. The !exists guard restricts
    // this branch to genuinely-new groups: an EXISTING group (incl.
    // soft-deleted/deleting/claiming/accountDeletion — groups are never
    // hard-deleted, so exists() stays true) is forced down the standard
    // groupAllowsClientWrites path. A founding group is clean by construction —
    // validGroupCreate forces createdBy==uid, memberIds==[uid], isDeleted==false,
    // and its keys().hasOnly excludes every *InProgress flag — so no
    // groupAllowsClientWrites re-check is needed. Atomicity finishes the proof:
    // if the group leg fails validGroupCreate the member/event legs cannot
    // persist regardless of their own verdicts, and getAfter reflects only the
    // caller's own request (no cross-request piggyback).
    function groupFoundingBatchByCreator(groupId) {
      return signedIn()
        && !exists(groupPath(groupId))
        && existsAfter(groupPath(groupId))
        && request.auth.uid in groupAfterData(groupId).memberIds
        && groupAfterData(groupId).createdBy == request.auth.uid;
    }

    function eventPath(groupId, eventId) {
      return /databases/$(database)/documents/groups/$(groupId)/events/$(eventId);
    }

    function eventData(groupId, eventId) {
      return get(eventPath(groupId, eventId)).data;
    }

    function eventAllowsClientWrites(groupId, eventId) {
      return groupAllowsClientWrites(groupId)
        && exists(eventPath(groupId, eventId))
        && (!eventData(groupId, eventId).keys().hasAny(['isDeleted'])
          || eventData(groupId, eventId).isDeleted == false);
    }

    // #723: gate for EXPENSE writes only — group writable, event exists, event
    // not soft-deleted AND not closed. Deliberately separate from the shared
    // eventAllowsClientWrites (which SETTLEMENTS keep using) so settlements stay
    // writable after close ("settlements stay live after close").
    //
    // It REPLACES eventAllowsClientWrites in the expense paths (does not stack on
    // top): map.get(key, default) folds the not-deleted + not-closed checks into
    // the SAME eventData() reference count as eventAllowsClientWrites's isDeleted
    // check — so the heavy validExpenseUpdate path does not gain expressions and
    // stays under the rules-engine 1000-expression ceiling. Absent-key-guarded so
    // legacy events (no isDeleted/isClosed key) keep accepting writes.
    function eventAcceptsExpenseWrites(groupId, eventId) {
      return groupAllowsClientWrites(groupId)
        && exists(eventPath(groupId, eventId))
        && eventData(groupId, eventId).get('isDeleted', false) == false
        && eventData(groupId, eventId).get('isClosed', false) == false;
    }

    function isEventParticipant(groupId, eventId) {
      return signedIn()
        && exists(eventPath(groupId, eventId))
        && request.auth.uid in eventData(groupId, eventId).participantIds;
    }

    // Money-record ownership (B1 — rewritten #248 PR4):
    // - Every expense/settlement carries an immutable `createdBy` (auth UID)
    //   stamped at create time.
    // - EXPENSES are now OPEN-edit: any event participant may edit/soft-delete any
    //   expense (validExpenseUpdate, was creator-only). `createdBy` stays immutable,
    //   the editor is pinned by `lastEditedBy == auth.uid` (unforgeable), and every
    //   change is server-audit-logged by the expenseAuditLogger trigger. A future
    //   `ledgerEditPolicy` ('open' | 'related') will wrap the participant branch.
    // - SETTLEMENTS are append-only: updates are denied outright (both settlement
    //   match blocks: `allow update: if false`). Corrections = a new offsetting row.
    // The `requesterIsRecordCreator` helper below is now referenced ONLY by
    // validEventSettlementUpdate/validGroupSettlementUpdate, which are themselves
    // dead (their match blocks hard-deny update) — retained as scaffolding for the
    // settlement-corrections track (#283), not wired to any live `allow` clause.
    function requesterIsRecordCreator() {
      return signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // FCM tokens: owner-only read/write (doc ID = user UID)
    match /fcm_tokens/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
    }

    // Invite codes are admin-readable only. Client joins must use the
    // joinGroupByInviteCode callable so codes are not brute-forceable through
    // direct Firestore reads.
    match /inviteCodes/{code} {
      allow get, list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'createdAt'])
        && request.resource.data.groupId is string
        && request.resource.data.createdAt is timestamp
        && existsAfter(groupPath(request.resource.data.groupId))
        && groupAfterData(request.resource.data.groupId).createdBy == request.auth.uid
        && groupAfterData(request.resource.data.groupId).inviteCode == code;

      allow update: if false;

      allow delete: if signedIn()
        && (
          !exists(/databases/$(database)/documents/inviteCodes/$(code))
          || (
            resource.data.groupId is string
            && exists(groupPath(resource.data.groupId))
            && groupData(resource.data.groupId).createdBy == request.auth.uid
            && !existsAfter(groupPath(resource.data.groupId))
          )
        );
    }

    match /joinAttempts/{userId} {
      allow read, write: if false;
    }

    // #73: per-UID deletion-invocation rate-limit counters. Server-only (the
    // deleteAccount callable writes them via the Admin SDK, which bypasses rules);
    // clients can never read or write. A Firestore TTL on `expiresAt` reaps them.
    match /deletionAttempts/{userId} {
      allow read, write: if false;
    }

    // #190: per-UID deleteGroup-invocation rate-limit counters. Server-only (the
    // deleteGroup callable writes them via the Admin SDK); clients never touch.
    // A Firestore TTL on `expiresAt` reaps them. Mirrors deletionAttempts.
    match /deleteGroupAttempts/{userId} {
      allow read, write: if false;
    }

    // #76: per-UID markers recording an incomplete account deletion, so the
    // deletionReaper scheduled backstop can finish abandoned/timed-out deletions.
    // Server-only (deleteAccount + the reaper write via the Admin SDK); clients
    // never read or write. A Firestore TTL on `expiresAt` is the safety net.
    match /deletionAudit/{userId} {
      allow read, write: if false;
    }

    match /groups/{groupId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberIds;
      }

      function isCreator() {
        return signedIn() && request.auth.uid == resource.data.createdBy;
      }

      function validGroupCreate() {
        return signedIn()
          && request.resource.data.keys().hasOnly([
            'id',
            'name',
            'inviteCode',
            'createdBy',
            'memberIds',
            'currency',
            'createdAt',
            'updatedAt',
            // #190: the create-path producer writes the soft-delete pair. The
            // userGroupsProvider hides soft-deleted groups with an in-memory
            // !group.isDeleted filter so legacy field-absent groups stay visible.
            // A group can never be created already-deleted.
            'isDeleted',
            'deletedAt',
            // #287 trip-stamps: optional decorative stamp (allow-listed glyph
            // enum + 0..5 ink swatch). Absent on legacy/monogram groups.
            'glyph',
            'inkIndex'
          ])
          && request.resource.data.id == groupId
          && isValidDisplayName(request.resource.data.name)
          && request.resource.data.inviteCode is string
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.memberIds == [request.auth.uid]
          && validCurrency(request.resource.data.currency)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.isDeleted == false
          && request.resource.data.deletedAt == null
          && (!('glyph' in request.resource.data)
            || validGlyph(request.resource.data.glyph))
          && (!('inkIndex' in request.resource.data)
            || validInkIndex(request.resource.data.inkIndex));
      }

      function validCreatorMetadataUpdate() {
        // #261/#382: currency is settable ONLY at create (validGroupCreate) and is
        // immutable thereafter — dropped from the metadata allow-list so a creator
        // cannot change it. Post-#382 group.currency is the DEFAULT currency for
        // new expenses (each money doc carries its own per-doc currency, bucketed
        // independently), not a constraint every money doc must match; but mutating
        // a live group's default has no benefit and is left immutable.
        // #287 trip-stamps: the creator may also set/clear the decorative stamp
        // (glyph + inkIndex). A field-DELETE that clears a stamp counts as an
        // affected key (present→absent), so both must sit in `hasOnly([...])` or
        // the clear-update would be denied; the guards below stay STRICT
        // (absent-or-valid), so an explicit-null write is still rejected.
        return isCreator()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'updatedAt', 'glyph', 'inkIndex'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
            || isValidDisplayName(request.resource.data.name))
          && request.resource.data.updatedAt is timestamp
          && (!('glyph' in request.resource.data)
            || validGlyph(request.resource.data.glyph))
          && (!('inkIndex' in request.resource.data)
            || validInkIndex(request.resource.data.inkIndex));
      }

      // #290 + #318: membership removal is server-authoritative. The `leaveGroup`
      // (self-leave) and `removeMember` (creator-remove) callables (Admin SDK,
      // rules-bypassing) recompute the leaver/target net balance, refuse on any
      // non-zero net, then remove the uid from memberIds + delete the member doc
      // + log `member_left`. A direct client self-leave (#290) OR creator-remove
      // (#318) is therefore forbidden — there is no `validSelfLeave` and no
      // `validCreatorRemoveMember` branch in `allow update`. Removing the
      // group-doc arrayRemove path is sufficient for BOTH: the member-doc delete
      // (`validMemberDelete`, self-branch and creator-branch) requires
      // `!(targetUserId in memberIds-after)`, achievable only by the now-blocked
      // group update, and the write batch is atomic.

      function validMemberIdsRefresh() {
        return isMember()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'updatedAt'])
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.updatedAt is timestamp;
      }

      allow read: if isMember();
      allow create: if validGroupCreate();
      allow update: if groupAllowsClientWrites(groupId)
        && (validCreatorMetadataUpdate()
          || validMemberIdsRefresh());
      // #190: group deletion is server-authoritative. The deleteGroup callable
      // (Admin SDK, rules-bypassing) recomputes net balances across all events +
      // group settlements, refuses on any non-zero net, then SOFT-deletes the
      // group + its events (isDeleted:true) while keeping the append-only
      // expense/settlement records reachable. The callable UPDATES the group doc
      // (never deletes it), so a direct client delete must be forbidden.
      allow delete: if false;

      match /events/{eventId} {
        function groupMembers() {
          return groupData(groupId).memberIds;
        }

        function requesterIsParticipant() {
          return signedIn() && request.auth.uid in resource.data.participantIds;
        }

        // Event-mutation policy (C-Hierarchy):
        // - Light path: any current event participant may rename, shift dates, edit
        //   description, and ADD participants (additive only - no removals, no
        //   participantNames key value changes).
        // - Admin path: event creator OR group creator may additionally remove
        //   participants, modify modules, and soft-delete the event.
        // Soft-delete remains one-way (false -> true) for both paths.
        function requesterIsEventCreator() {
          return signedIn() && resource.data.createdBy == request.auth.uid;
        }

        function requesterIsGroupCreator() {
          return signedIn()
            && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
        }

        function requesterIsEventAdmin() {
          return requesterIsEventCreator() || requesterIsGroupCreator();
        }

        function validModules(modules) {
          return modules is map
            && modules.keys().hasOnly(['ledger'])
            && modules.ledger is bool;
        }

        function validEventBase(data) {
          return isValidDisplayName(data.name)
            && data.type in ['trip', 'camping', 'travel', 'night_day_out', 'custom']
            && data.groupId == groupId
            && data.createdBy is string
            && data.participantIds is list
            && data.participantIds.size() > 0
            && data.participantIds.hasOnly(groupMembers())
            && data.participantNames is map
            && displayNameMapValuesAreValid(data.participantNames)
            && validModules(data.modules)
            && (data.startDate == null || data.startDate is timestamp)
            && (data.endDate == null || data.endDate is timestamp)
            && data.isDeleted is bool
            && (data.deletedAt == null || data.deletedAt is timestamp)
            && (data.createdAt is string || data.createdAt is timestamp)
            && (data.serverCreatedAt == null || data.serverCreatedAt is timestamp)
            && (data.updatedAt == null || data.updatedAt is timestamp)
            && nullableString(data.description);
          // #723 NOTE: the close triple (isClosed/closedAt/closedBy) is
          // intentionally NOT re-validated here. validEventBase runs on the hot
          // light+admin update paths (twice per update via validEventUpdateCommon);
          // adding three more checks tipped the rules-engine 1000-expression
          // ceiling. It is safe to omit: create validates the triple explicitly
          // (born false/null), validEventCloseToggle validates it on close/reopen,
          // and the light/admin diff allow-lists exclude the three keys, so no
          // other path can mutate them.
        }

        // #874: create-only twin of validEventBase's field-shape checks, WITHOUT
        // the participantIds.hasOnly(groupMembers()) membership coupling
        // (groupMembers() does get(group), which is null in a founding batch ->
        // a terminal rule error). The membership check is applied per-branch in
        // validEventCreate (standard: committed groupMembers(); founding batch:
        // after-state groupAfterData().memberIds).
        //
        // MUST MIRROR validEventBase's field list (this file, validEventBase).
        // A new event field goes in BOTH. validEventBase and the entire
        // event-UPDATE OR-chain are deliberately left byte-identical — they sit
        // near the 1000-expression ceiling (#723), so this create-only path does
        // NOT touch them (duplication over extraction on purpose).
        function validEventCreateFields(data) {
          return isValidDisplayName(data.name)
            && data.type in ['trip', 'camping', 'travel', 'night_day_out', 'custom']
            && data.groupId == groupId
            && data.createdBy is string
            && data.participantIds is list
            && data.participantIds.size() > 0
            && data.participantNames is map
            && displayNameMapValuesAreValid(data.participantNames)
            && validModules(data.modules)
            && (data.startDate == null || data.startDate is timestamp)
            && (data.endDate == null || data.endDate is timestamp)
            && data.isDeleted is bool
            && (data.deletedAt == null || data.deletedAt is timestamp)
            && (data.createdAt is string || data.createdAt is timestamp)
            && (data.serverCreatedAt == null || data.serverCreatedAt is timestamp)
            && (data.updatedAt == null || data.updatedAt is timestamp)
            && nullableString(data.description);
        }

        function validEventCreate() {
          return request.resource.data.keys().hasOnly([
              'name',
              'type',
              'groupId',
              'createdBy',
              'participantIds',
              'participantNames',
              'modules',
              'startDate',
              'endDate',
              'isDeleted',
              'deletedAt',
              'createdAt',
              'serverCreatedAt',
              'updatedAt',
              'description',
              'isClosed',
              'closedAt',
              'closedBy'
            ])
            && request.resource.data.createdBy == request.auth.uid
            && request.auth.uid in request.resource.data.participantIds
            && request.resource.data.isDeleted == false
            && request.resource.data.deletedAt == null
            // #723: events are born open.
            && (!('isClosed' in request.resource.data) || request.resource.data.isClosed == false)
            && (!('closedAt' in request.resource.data) || request.resource.data.closedAt == null)
            && (!('closedBy' in request.resource.data) || request.resource.data.closedBy == null)
            && validEventCreateFields(request.resource.data)
            && (
              // Standard: existing group, requester is a member, participants
              // ⊆ committed members.
              (isGroupMember(groupId) && groupAllowsClientWrites(groupId)
                && request.resource.data.participantIds.hasOnly(groupMembers()))
              // #874 founding batch: the #245 seeded event rides in the SAME
              // atomic batch as its brand-new group. participantIds ⊆ after-state
              // members (== [creator], so this collapses to exactly [creator]).
              || (groupFoundingBatchByCreator(groupId)
                && request.resource.data.participantIds.hasOnly(groupAfterData(groupId).memberIds))
            );
        }

        function validEventUpdateCommon() {
          return request.resource.data.groupId == resource.data.groupId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.type == resource.data.type
            && request.resource.data.createdAt == resource.data.createdAt
            && validEventBase(request.resource.data);
        }

        function validEventLightUpdate() {
          return requesterIsParticipant()
            && eventAllowsClientWrites(groupId, eventId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'name',
                'participantIds',
                'participantNames',
                'startDate',
                'endDate',
                'updatedAt',
                'description'
              ])
            && validEventUpdateCommon()
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['participantIds'])
              || request.resource.data.participantIds.hasAll(resource.data.participantIds))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['participantNames'])
              || (request.resource.data.participantNames.diff(resource.data.participantNames).removedKeys().size() == 0
                && request.resource.data.participantNames.diff(resource.data.participantNames).changedKeys().size() == 0));
        }

        function validEventAdminUpdate() {
          return requesterIsEventAdmin()
            && eventAllowsClientWrites(groupId, eventId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'name',
                'participantIds',
                'participantNames',
                'modules',
                'startDate',
                'endDate',
                'isDeleted',
                'deletedAt',
                'updatedAt',
                'description'
              ])
            && validEventUpdateCommon()
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDeleted', 'deletedAt'])
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'deletedAt', 'updatedAt'])
                && resource.data.isDeleted == false
                && request.resource.data.isDeleted == true
                && request.resource.data.deletedAt is timestamp));
        }

        // #766 — spendingSnapshot is an OPAQUE display-only blob (the frozen
        // SPENDING half of the recap, written on close, DELETEd on reopen). The
        // oracle / recomputeNet / every Function NEVER read it (same contract as
        // splitExplanation). Guard type + a generous top-level entry-count cap
        // only; content is intentionally unvalidated — the 1 MB doc limit is the
        // real payload backstop. Absent (every non-close update, and reopen's
        // FieldValue.delete) passes via !hasAny.
        function spendingSnapshotBounded(d) {
          return !d.keys().hasAny(['spendingSnapshot'])
            || (d.spendingSnapshot is map && d.spendingSnapshot.size() <= 16);
        }

        // #723 close lifecycle (close + reopen folded into ONE function).
        //
        // Cheap diff-gate FIRST so a non-toggle update (rename, participant edit,
        // soft-delete) short-circuits here with zero document gets — keeping the
        // event update OR-chain under the rules-engine 1000-expression ceiling.
        // The expensive admin + group-writable checks run ONCE (shared by both
        // shapes), and only for a genuine close/reopen-shaped write.
        //
        // Deliberately does NOT call validEventUpdateCommon / validEventBase:
        // re-running the base re-asserts participantIds.hasOnly(groupMembers()),
        // which would permanently block closing any event with a departed
        // participant (#249) — the exact post-trip closeout case. The
        // diff().hasOnly([5 keys]) already pins every other field immutable, so the
        // base re-check is both redundant and harmful. Mirrors validSoftDelete.
        // #766: spendingSnapshot joins the allow-list (close writes it, reopen
        // DELETEs it) + a cheap opaque bounds check, both after the diff gate.
        function validEventCloseToggle() {
          return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isClosed', 'closedAt', 'closedBy', 'updatedAt', 'spendingSnapshot'])
            && request.resource.data.updatedAt is timestamp
            && spendingSnapshotBounded(request.resource.data)
            && requesterIsEventAdmin()
            && eventAllowsClientWrites(groupId, eventId)
            && (
              // close: open/legacy -> closed (closedBy pinned to caller)
              ((!('isClosed' in resource.data) || resource.data.isClosed == false)
                && request.resource.data.isClosed == true
                && request.resource.data.closedAt is timestamp
                && request.resource.data.closedBy == request.auth.uid)
              ||
              // reopen: closed -> open (clears closedAt/closedBy). Requires the key
              // present + true so a never-closed/legacy doc cleanly denies.
              (('isClosed' in resource.data) && resource.data.isClosed == true
                && request.resource.data.isClosed == false
                && request.resource.data.closedAt == null
                && request.resource.data.closedBy == null)
            );
        }

        allow read: if isGroupMember(groupId);
        allow create: if validEventCreate();
        allow update: if validEventLightUpdate()
          || validEventAdminUpdate()
          || validEventCloseToggle();
        allow delete: if false;

        match /{module}/{docId} {
          function participants() {
            return eventData(groupId, eventId).participantIds;
          }

          function validExpenseSplit(data, enforceParticipantKeys) {
            return (!data.keys().hasAny(['splitMode'])
                || data.splitMode in ['equally', 'shares', 'exact', 'percent'])
              && (!data.keys().hasAny(['splitDistribution'])
                || (data.splitDistribution is map
                  && (!enforceParticipantKeys
                    || data.splitDistribution.keys().hasOnly(participants()))));
          }

          // #192 - splitDistribution values are non-negative integers. Firestore
          // Rules has no numeric fold, so coerce the int list to a string with
          // join(',') and assert it is only digits and commas (no '-', '.', or
          // 'e'). Enforced in the create/update WRAPPERS (unconditional create,
          // diff-gated update) — NOT inside validExpenseSplit, which re-runs
          // wholesale on every update including soft-delete; gating here keeps a
          // legacy/forged negative doc soft-deletable. HONEST RESIDUAL: sum ==
          // amount is NOT enforced (no numeric fold); the client allocator owns
          // that. An all-positive over-allocation still passes the rules.
          function splitValuesNonNegative(d) {
            return !d.keys().hasAny(['splitDistribution'])
              || d.splitDistribution.values().size() == 0
              || d.splitDistribution.values().join(',').matches('^[0-9,]+$');
          }

          // #203 - splitExplanation is OPAQUE display-only metadata (balance
          // truth stays in splitDistribution; the server never reads it). Guard
          // type + a generous top-level entry-count cap only; value content is
          // intentionally unvalidated. NOTE: map.size() counts entry COUNT, not
          // value weight — the 1MB Firestore doc limit is the hard payload
          // backstop. Kept in the create/update WRAPPERS (not validExpenseBase)
          // so a legacy/forged oversized doc stays soft-deletable (the #192/#194
          // pattern). Wired unconditionally on create, diff-gated on update.
          function splitExplanationBounded(d) {
            return !d.keys().hasAny(['splitExplanation'])
              || (d.splitExplanation is map && d.splitExplanation.size() <= 64);
          }

          // #194 - free-text fields present on every expense create map
          // (expense_service.dart writes all of them). Bounds + charset; the
          // base keeps nullableString for the type guarantee.
          function validExpenseFreeText(d) {
            return validFreeText(d.description)
              && validFreeText(d.note)
              && validFreeText(d.categoryId)
              && validFreeText(d.receiptUrl)
              && validFreeText(d.subGroupId);
          }

          // #194 - on update, re-validate a free-text field only when the diff
          // touches it, so unchanged legacy values are never re-checked (keeps
          // soft-delete of legacy long / control-char docs working).
          function expenseFreeTextDiffOk() {
            return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['description'])
                || validFreeText(request.resource.data.description))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['note'])
                || validFreeText(request.resource.data.note))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['categoryId'])
                || validFreeText(request.resource.data.categoryId))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['receiptUrl'])
                || validFreeText(request.resource.data.receiptUrl))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['subGroupId'])
                || validFreeText(request.resource.data.subGroupId));
          }

          function validExpenseBase(data, enforceParticipantKeys) {
            return data.keys().hasOnly([
              'id',
              'eventId',
              'createdBy',
              'payerParticipantId',
              'amountFils',
              'currency',
              'description',
              'scope',
              'subGroupId',
              'customSplitParticipants',
              'splitMode',
              'splitDistribution',
              'receiptUrl',
              'categoryId',
              'note',
              'isDeleted',
              'deletedAt',
              'createdAt',
              'lastEditedBy',
              'splitExplanation',
              'claimRekeyAt',
              'deleteAccountScrubAt'
            ])
            && data.id == docId
            && data.eventId == eventId
            && data.createdBy is string
            && data.createdBy.size() > 0
            && data.payerParticipantId in participants()
            && positiveInt(data.amountFils)
            && validCurrency(data.currency)
            && data.scope in ['global', 'sub_group', 'personal', 'custom']
            && nullableString(data.subGroupId)
            && data.customSplitParticipants is list
            && data.customSplitParticipants.hasOnly(participants())
            && validExpenseSplit(data, enforceParticipantKeys)
            && nullableString(data.receiptUrl)
            && nullableString(data.categoryId)
            && nullableString(data.description)
            && nullableString(data.note)
            && data.isDeleted is bool
            && (data.deletedAt == null || data.deletedAt is string)
            && (!('claimRekeyAt' in data) || data.claimRekeyAt is timestamp)
            && (!('deleteAccountScrubAt' in data) || data.deleteAccountScrubAt is timestamp)
            && data.createdAt is string;
          }

          function validExpenseCreate() {
            // #1131: leave/remove never prune event participantIds (balance-
            // universe preservation), so participation alone is NOT current
            // membership — a departed member would retain write authority
            // forever. Require live memberIds too. The counterparty universe
            // (participants()) is deliberately untouched: current members must
            // keep writing expenses that REFERENCE departed participants
            // (#249 parity contract).
            return module == 'expenses'
              && isGroupMember(groupId)
              && isEventParticipant(groupId, eventId)
              && eventAcceptsExpenseWrites(groupId, eventId)
              && validExpenseBase(request.resource.data, true)
              && splitValuesNonNegative(request.resource.data)
              && splitExplanationBounded(request.resource.data)
              && validExpenseFreeText(request.resource.data)
              && request.resource.data.createdBy == request.auth.uid
              // #248: when present, lastEditedBy must be the caller (unforgeable
              // attribution for PR2's audit trigger). Presence-gated so a
              // pre-feature client that omits it still creates.
              && (!('lastEditedBy' in request.resource.data)
                || request.resource.data.lastEditedBy == request.auth.uid)
              && !request.resource.data.keys().hasAny(['claimRekeyAt', 'deleteAccountScrubAt'])
              && request.resource.data.isDeleted == false
              && request.resource.data.deletedAt == null;
          }

          function validSoftDelete() {
            // #248: a new client stamps lastEditedBy on soft-delete so PR2's
            // trigger can attribute the deleter — permit it alongside the
            // isDeleted/deletedAt pair. The lastEditedBy value is pinned to the
            // caller by validExpenseUpdate's diff-gated check. Only the LIVE
            // expense path reaches this fn (validSoftDelete's other reference,
            // inside validEventSettlementUpdate, is dead code — settlement
            // updates are denied at `allow update: if false`, firestore.rules
            // settlements block), so this loosening cannot widen settlements.
            return request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['isDeleted', 'deletedAt', 'lastEditedBy'])
              && resource.data.isDeleted == false
              && request.resource.data.isDeleted == true
              && request.resource.data.deletedAt is string;
          }

          function affectsExpenseAllocation() {
            return request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'payerParticipantId',
                'amountFils',
                'currency',
                'scope',
                'subGroupId',
                'customSplitParticipants',
                'splitMode',
                'splitDistribution'
              ]);
          }

          function validExpenseUpdate() {
            // #248 PR4: OPEN edit — ANY event participant may edit/soft-delete any
            // expense (was creator-only via requesterIsRecordCreator, dropped here).
            // isEventParticipant is the single who-can-edit branch; a future
            // ledgerEditPolicy ('open' | 'related') read would wrap it. WHO widened;
            // WHAT is unchanged — every value/immutability guard below still holds,
            // and the lastEditedBy==auth.uid pin keeps the editor unforgeable so the
            // expenseAuditLogger trigger (live since PR2) attributes each change.
            return module == 'expenses'
              && isGroupMember(groupId) // #1131 — see validExpenseCreate
              && isEventParticipant(groupId, eventId)
              && eventAcceptsExpenseWrites(groupId, eventId)
              && request.resource.data.createdBy == resource.data.createdBy
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'payerParticipantId',
                  'amountFils',
                  'currency',
                  'description',
                  'scope',
                  'subGroupId',
                  'customSplitParticipants',
                  'splitMode',
                  'splitDistribution',
                  'receiptUrl',
                  'categoryId',
                  'note',
                  'isDeleted',
                  'deletedAt',
                  'lastEditedBy',
                  'splitExplanation'
                ])
              && validExpenseBase(request.resource.data, affectsExpenseAllocation())
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['splitDistribution'])
                || splitValuesNonNegative(request.resource.data))
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['splitExplanation'])
                || splitExplanationBounded(request.resource.data))
              // #382 PR-6: per-expense currency. An expense's currency need only be
              // a SUPPORTED code (validExpenseBase validCurrency floor at :563), no
              // longer one that equals group.currency — the old diff-gated
              // currencyMatchesGroup clause is deleted. The client never exposes an
              // edit-currency control (edit mode is currency-immutable), so a
              // valid-code currency change on update is rules-permitted but
              // unexercised (L10).
              // #248 PR4: lastEditedBy is now MANDATORY and pinned to the caller on
              // EVERY expense update (was diff-gated in PR1). With edit open to any
              // participant, an editor who OMITTED lastEditedBy would let the
              // expenseAuditLogger trigger fall back to `createdBy` and blame the
              // wrong person (silent misattribution) — so self-attribution is forced:
              // the merged doc must end with lastEditedBy == the caller. The live
              // client always re-stamps it on every update/soft-delete path
              // (edit_expense_screen.dart), so the PR1 merge-preservation footgun
              // (an update that doesn't re-stamp inheriting a stale value) cannot
              // occur. Only pre-PR1 clients omit it — none in the field (no users).
              && request.resource.data.lastEditedBy == request.auth.uid
              && expenseFreeTextDiffOk()
              && (
                (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDeleted', 'deletedAt'])
                  && request.resource.data.isDeleted == resource.data.isDeleted
                  && request.resource.data.deletedAt == resource.data.deletedAt)
                || validSoftDelete()
              );
          }

          function validEventSettlementBase(data) {
            // #889: deliberately does NOT list `correctionOfSettlementId` —
            // hasOnly-omission denies any client create carrying it (deny-by-
            // omission, not an explicit deny). This is what makes the
            // settlementNotifier.ts / writeRateMonitor.ts presence-only
            // marker skips un-forgeable: only the Admin SDK (which bypasses
            // this check) can write the key. Do NOT add the marker here.
            return data.keys().hasOnly([
              'id',
              'eventId',
              'createdBy',
              'payerParticipantId',
              'recipientParticipantId',
              'amountFils',
              'currency',
              'note',
              'payerName',
              'recipientName',
              'isDeleted',
              'deletedAt',
              'settledAt',
              'groupSettleUpId'
            ])
            && data.id == docId
            && data.eventId == eventId
            && data.payerParticipantId in participants()
            && data.recipientParticipantId in participants()
            && isValidNullableDisplayName(data.payerName)
            && isValidNullableDisplayName(data.recipientName)
            // #382 PR-6: a settlement's currency need only be a SUPPORTED code
            // (validSettlementCore validCurrency floor), no longer one that equals
            // group.currency — the old currencyMatchesGroup equality is deleted.
            // The stepped-settle UI only offers currencies with a non-zero bucket
            // client-side (L3); the server just validates a supported code.
            && validSettlementCore(data);
          }

          function validEventSettlementCreate() {
            // #752: writer need only be a group MEMBER (was isEventParticipant),
            // so a group-level settle-up decomposed into per-event settlement
            // docs — and #595 settle-on-behalf — are accepted. The counterparties
            // are STILL gated to event participants (validEventSettlementBase
            // payerParticipantId/recipientParticipantId in participants()). This
            // matches the #595 "any member may record a transfer between two
            // others" model and is no broader than today's group-settlement
            // permission (any member may already create a group settlement
            // between two members). It is NOT a strict subset — participants()
            // can include a departed event-participant no longer in memberIds
            // (#249) — but is safe: parties are real prior event participants,
            // settlements are append-only + offset-correctable, and the rule is
            // a shape-gate not a value-gate.
            return module == 'settlements'
              && isGroupMember(groupId)
              && eventAllowsClientWrites(groupId, eventId)
              && validEventSettlementBase(request.resource.data)
              && validFreeText(request.resource.data.note)
              && request.resource.data.createdBy == request.auth.uid
              && request.resource.data.isDeleted == false
              && request.resource.data.deletedAt == null;
          }

          function validEventSettlementUpdate() {
            return module == 'settlements'
              && isEventParticipant(groupId, eventId)
              && eventAllowsClientWrites(groupId, eventId)
              && requesterIsRecordCreator()
              && request.resource.data.createdBy == resource.data.createdBy
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['note', 'isDeleted', 'deletedAt'])
              && validEventSettlementBase(request.resource.data)
              && (
                (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDeleted', 'deletedAt'])
                  && request.resource.data.isDeleted == resource.data.isDeleted
                  && request.resource.data.deletedAt == resource.data.deletedAt)
                || validSoftDelete()
              );
          }

          allow read: if isGroupMember(groupId)
            && module in ['expenses', 'settlements', 'activity_logs'];
          // #248: event activity_logs are written ONLY by the expenseAuditLogger
          // trigger via the Admin SDK (which bypasses rules). Clients may READ but
          // never create/update/delete — a client cannot forge an audit entry.
          // (update is validExpenseUpdate(), module-gated to 'expenses'; delete is
          // false; create no longer has an activity branch.)
          allow create: if validExpenseCreate()
            || validEventSettlementCreate();
          allow update: if validExpenseUpdate();
          allow delete: if false;

          match /{nestedCol}/{nestedDocId} {
            allow read, write: if false;
          }
        }

        match /settlements/{settlementId} {
          // B3: settlements are append-only.
          allow update: if false;
          // B3: settlements are append-only.
          allow delete: if false;
        }
      }

      match /members/{memberId} {
        function groupExistsAfter() {
          return existsAfter(groupPath(groupId));
        }

        function groupAfterMemberIds() {
          return groupAfterData(groupId).memberIds;
        }

        function validMemberCreate() {
          return (
              // Standard path: the group already exists and the requester is a
              // member (joiner self-add on an existing group).
              (isGroupMember(groupId) && groupAllowsClientWrites(groupId))
              // #874 founding batch: the creator's own member doc rides in the
              // SAME atomic batch as the brand-new group (see
              // groupFoundingBatchByCreator).
              || groupFoundingBatchByCreator(groupId)
            )
            && request.resource.data.keys().hasOnly([
              'id',
              'userId',
              'displayName',
              'role',
              'joinedAt',
              'isShadow'
            ])
            && request.resource.data.id == memberId
            // #524: bind the member doc id to the uid so client-side member
            // creation is one deterministic doc per uid (members/{uid}). With
            // id == memberId above, this forces memberId == uid, blocking a
            // member from forging unlimited extra docs under fresh client-chosen
            // ids. Joiners (joinGroupByInviteCode, Admin SDK) already key by
            // uid; createGroup now does too (group_provider.dart).
            && request.resource.data.id == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && isValidDisplayName(request.resource.data.displayName)
            && request.resource.data.role in ['CREATOR', 'MEMBER']
            // #874: after-state createdBy. For a standalone create the group is
            // not in the write so getAfter == get (unchanged); in a founding
            // batch it sees the new group's createdBy. createdBy is immutable
            // post-create (absent from every group-update allow-list), so this
            // never differs from the before-state read on the standard path.
            && (request.resource.data.role == 'MEMBER'
              || groupAfterData(groupId).createdBy == request.auth.uid)
            && request.resource.data.joinedAt is timestamp
            && request.resource.data.isShadow is bool;
        }

        function validSelfDisplayNameUpdate() {
          return isGroupMember(groupId)
            && groupAllowsClientWrites(groupId)
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName'])
            && isValidDisplayName(request.resource.data.displayName);
        }

        function validMemberDelete() {
          return signedIn()
            && exists(groupPath(groupId))
            && groupAllowsClientWrites(groupId)
            && (
              (groupExistsAfter()
                && resource.data.userId == request.auth.uid
                && !(request.auth.uid in groupAfterMemberIds()))
              || (groupData(groupId).createdBy == request.auth.uid
                && (!groupExistsAfter()
                  || !(resource.data.userId in groupAfterMemberIds())))
            );
        }

        allow read: if isGroupMember(groupId);
        allow create: if validMemberCreate();
        allow update: if validSelfDisplayNameUpdate();
        allow delete: if validMemberDelete();
      }

      match /activity/{activityId} {
        // #814 — value-domain floor for client-forgeable metadata (spirit of
        // #192/#193/#194). Known keys are absent-or-typed via the single-
        // reference get() pattern (#723); ids and unknown keys stay opaque;
        // the map is key-count bounded. Server writers (expense_* fan-in,
        // member_left callables) use the Admin SDK and bypass this.
        function validActivityMetadata(md) {
          return md.size() <= 16
            && md.get('amountFils', 0) is int
            && md.get('amountFils', 0) >= 0
            && validCurrency(md.get('currency', 'OMR'))
            && md.get('amount', '') is string
            && md.get('eventName', '') is string
            && md.get('memberName', '') is string
            && md.get('memberAction', '') is string
            && md.get('recipientId', '') is string
            && md.get('fromUserId', '') is string
            && md.get('toUserId', '') is string
            && md.get('fromName', '') is string
            && md.get('toName', '') is string;
        }

        function validGroupActivityCreate() {
          return isGroupMember(groupId)
            && groupAllowsClientWrites(groupId)
            && request.resource.data.keys().hasOnly([
              'id',
              'type',
              'actorId',
              'actorName',
              'description',
              'metadata',
              'timestamp'
            ])
            && request.resource.data.id == activityId
            && request.resource.data.actorId == request.auth.uid
            // #808 PR1: allow-list of CLIENT-written types. member_left is
            // written only by the leaveGroup/removeMember callables and
            // expense_* only by the expenseAuditLogger fan-in (both Admin
            // SDK, bypassing rules) — a client claiming them is a forgery.
            // The writeRateMonitor's expense_* skip is only safe because of
            // this list; extend BOTH together. #831: event_settlement is
            // CLIENT-written (event settle-up record path) — allow-listed
            // here and deliberately NOT in the monitor skip (a real client
            // write is counted, like group_settlement).
            && request.resource.data.type in [
              'event_created',
              'event_deleted',
              'event_settlement',
              'group_settlement',
              'member_joined'
            ]
            && isValidDisplayName(request.resource.data.actorName)
            && request.resource.data.description is string
            && request.resource.data.metadata is map
            && validActivityMetadata(request.resource.data.metadata)
            && request.resource.data.timestamp is string;
        }

        allow read: if isGroupMember(groupId);
        allow create: if validGroupActivityCreate();
        allow update, delete: if false;
      }

      // #366 — server-maintained balance aggregate (display cache for the home
      // dashboard). Written ONLY by the balanceAggregator triggers and the
      // balanceReconciler via the Admin SDK (which bypasses rules). Clients
      // read, never write — the aggregate must never become an OUTBOUND money
      // surface, and a forged client write would corrupt the home display for
      // every member.
      match /aggregates/{aggregateId} {
        allow read: if isGroupMember(groupId);
        allow create, update, delete: if false;
      }

      match /settlements/{settlementId} {
        function validGroupSettlementBase(data) {
          // #889: deliberately does NOT list `correctionOfSettlementId` —
          // hasOnly-omission denies any client create carrying it (deny-by-
          // omission, not an explicit deny). This is what makes the
          // settlementNotifier.ts / writeRateMonitor.ts presence-only marker
          // skips un-forgeable: only the Admin SDK (which bypasses this
          // check) can write the key. Do NOT add the marker here.
          return data.keys().hasOnly([
            'id',
            'groupId',
            'eventId',
            'createdBy',
            'scope',
            'payerParticipantId',
            'recipientParticipantId',
            'amountFils',
            'currency',
            'note',
            'payerName',
            'recipientName',
            'isDeleted',
            'deletedAt',
            'settledAt',
            'groupSettleUpId'
          ])
          && data.id == settlementId
          && data.groupId == groupId
          // Group settlements reuse the Settlement model with eventId pinned to
          // groupId as a sentinel (group-level, not tied to any event). Migrating
          // this overloaded field is tracked in #71 — do not relax this binding
          // without that schema change.
          && data.eventId == groupId
          && data.scope == 'group'
          && data.payerParticipantId in groupData(groupId).memberIds
          && data.recipientParticipantId in groupData(groupId).memberIds
          && isValidNullableDisplayName(data.payerName)
          && isValidNullableDisplayName(data.recipientName)
          // #382 PR-6: a group settlement's currency need only be a SUPPORTED code
          // (validSettlementCore validCurrency floor), no longer one that equals
          // group.currency — the old equality is deleted. The stepped-settle UI
          // only offers currencies with a non-zero bucket client-side (L3); the
          // server just validates a supported code. A crafted settlement in a
          // no-debt currency is append-only (B3) and correctable by an offsetting
          // row, so no server bucket-existence check is needed.
          && validSettlementCore(data);
        }

        function validGroupSettlementCreate() {
          return isGroupMember(groupId)
            && groupAllowsClientWrites(groupId)
            && validGroupSettlementBase(request.resource.data)
            && validFreeText(request.resource.data.note)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.isDeleted == false
            && request.resource.data.deletedAt == null;
        }

        function validGroupSettlementUpdate() {
          return isGroupMember(groupId)
            && groupAllowsClientWrites(groupId)
            && requesterIsRecordCreator()
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['note', 'isDeleted', 'deletedAt'])
            && validGroupSettlementBase(request.resource.data)
            && (
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDeleted', 'deletedAt'])
                && request.resource.data.isDeleted == resource.data.isDeleted
                && request.resource.data.deletedAt == resource.data.deletedAt)
              || (
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['isDeleted', 'deletedAt'])
                && resource.data.isDeleted == false
                && request.resource.data.isDeleted == true
                && request.resource.data.deletedAt is string
              )
            );
        }

        allow read: if isGroupMember(groupId);
        allow create: if validGroupSettlementCreate();
        // B3: settlements are append-only.
        allow update: if false;
        // B3: settlements are append-only.
        allow delete: if false;
      }

      // #198: per-UID write-rate counters, written ONLY by the writeRateMonitor
      // triggers via the Admin SDK (which bypasses rules). Clients never touch
      // them. The recursive default-deny already denies this path; this explicit
      // match documents the intent and mirrors the joinAttempts/deletionAttempts
      // server-only convention. A Firestore TTL on `expiresAt` reaps them.
      match /_writeCounters/{uid} {
        allow read, write: if false;
      }

      // #278 claim/merge: a claim request is fully callable-mediated. The
      // requester (pre-join, NOT a member — D8) opens it via requestClaimShadow
      // and polls via listMyClaimRequests; the creator polls via
      // listGroupClaimRequests and decides via decideClaimRequest — all Admin SDK
      // (which bypasses rules). NO client read or write: a client read would need
      // a non-member carve-out fighting the member-gated convention, and a client
      // write would let a stranger forge an approval/claim.
      match /claimRequests/{requestId} {
        allow read, write: if false;
      }

      // #710: per-shadow claim reservations are Admin-only. The member-readable
      // group doc carries only non-identifying freeze fields; the tuple stays
      // hidden here with the server-only request document.
      match /claimShadowLocks/{shadowMemberId} {
        allow read, write: if false;
      }
    }
  }
}
