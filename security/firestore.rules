rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Invite codes: public read for joining, authenticated write
    match /inviteCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Groups
    match /groups/{groupId} {
      // In-document membership check -- no get() call needed (D-14)
      function isMember() {
        return request.auth != null &&
               request.auth.uid in resource.data.memberIds;
      }

      function isValidGroupCreate() {
        return request.auth != null &&
               request.resource.data.name is string &&
               request.resource.data.name.size() > 0 &&
               request.resource.data.memberIds is list &&
               request.resource.data.currency is string;
      }

      // Joining: authenticated user adds ONLY their own UID to memberIds.
      // Uses request.resource (post-write state) so the joiner's UID is present.
      function isValidJoin() {
        return request.auth != null &&
               request.auth.uid in request.resource.data.memberIds &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['memberIds', 'updatedAt']);
      }

      allow read: if isMember();
      allow create: if isValidGroupCreate();
      allow update: if isMember() || isValidJoin();
      allow delete: if false;

      // Events subcollection -- more restrictive than generic subcollection rule (D-32)
      match /events/{eventId} {
        function isGroupMemberForEvent() {
          return request.auth != null &&
            request.auth.uid in
              get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        function isEventParticipant() {
          return request.auth != null &&
            request.auth.uid in resource.data.participantIds;
        }

        function isValidEventCreate() {
          return request.auth != null &&
            request.resource.data.name is string &&
            request.resource.data.name.size() > 0 &&
            request.resource.data.type is string &&
            request.resource.data.participantIds is list &&
            request.resource.data.participantIds.size() > 0;
        }

        // Any group member can read all events (transparency, D-32)
        allow read: if isGroupMemberForEvent();
        // Any group member can create events (D-07)
        allow create: if isGroupMemberForEvent() && isValidEventCreate();
        // Only event participants can update event data
        allow update: if isEventParticipant();
        // No hard deletes -- soft delete only via update (D-09)
        allow delete: if false;

        // Module subcollections (expenses, settlements, gear, etc.)
        // Any event participant can read/write module data (D-11)
        match /{module}/{docId} {
          function isEventParticipantForModule() {
            return request.auth != null &&
              request.auth.uid in
                get(/databases/$(database)/documents/groups/$(groupId)/events/$(eventId)).data.participantIds;
          }
          allow read, write: if isEventParticipantForModule();
        }
      }

      // Group subcollections -- ONE get() call to parent for membership
      match /{subcollection}/{docId} {
        function isGroupMember() {
          return request.auth != null &&
            request.auth.uid in
              get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }
        allow read, write: if isGroupMember();
      }
    }
  }
}
