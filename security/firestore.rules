rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // FCM tokens: owner-only read/write (doc ID = user UID)
    match /fcm_tokens/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Invite codes: authenticated read, shape-validated create, no updates
    match /inviteCodes/{code} {
      // Read: authenticated users only (join flow needs to look up groupId)
      allow read: if request.auth != null;
      // Write: only via group create/delete batch (authenticated)
      // The inviteCode doc stores {groupId, createdAt} -- validate shape
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['groupId', 'createdAt'])
        && request.resource.data.groupId is string;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Groups
    match /groups/{groupId} {
      // In-document membership check -- no get() call needed (D-14)
      function isMember() {
        return request.auth != null &&
               request.auth.uid in resource.data.memberIds;
      }

      function isValidGroupCreate() {
        return request.auth != null &&
               request.resource.data.name is string &&
               request.resource.data.name.size() > 0 &&
               request.resource.data.memberIds is list &&
               request.resource.data.currency is string;
      }

      // Joining: authenticated user adds ONLY their own UID to memberIds.
      // Uses request.resource (post-write state) so the joiner's UID is present.
      function isValidJoin() {
        return request.auth != null &&
               request.auth.uid in request.resource.data.memberIds &&
               request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['memberIds', 'updatedAt']);
      }

      allow read: if isMember();
      allow create: if isValidGroupCreate();
      allow update: if isMember() || isValidJoin();
      // Creator-only delete via createdBy field (set at group creation, never updated)
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      // Events subcollection -- more restrictive than generic subcollection rule (D-32)
      match /events/{eventId} {
        function isGroupMemberForEvent() {
          return request.auth != null &&
            request.auth.uid in
              get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }

        function isEventParticipant() {
          return request.auth != null &&
            request.auth.uid in resource.data.participantIds;
        }

        function isValidEventCreate() {
          return request.auth != null &&
            request.resource.data.name is string &&
            request.resource.data.name.size() > 0 &&
            request.resource.data.type is string &&
            request.resource.data.participantIds is list &&
            request.resource.data.participantIds.size() > 0;
        }

        // Any group member can read all events (transparency, D-32)
        allow read: if isGroupMemberForEvent();
        // Any group member can create events (D-07)
        allow create: if isGroupMemberForEvent() && isValidEventCreate();
        // Only event participants can update event data
        allow update: if isEventParticipant();
        // No hard deletes -- soft delete only via update (D-09)
        allow delete: if false;

        // Module subcollections (expenses, settlements, gear, etc.)
        match /{module}/{docId} {
          // Read: any group member (avoids race condition when event doc
          // hasn't committed on server yet -- group membership is already stable)
          // Write: event participants only
          function isGroupMemberForModule() {
            return request.auth != null &&
              request.auth.uid in
                get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
          }
          function isEventParticipantForModule() {
            return request.auth != null &&
              request.auth.uid in
                get(/databases/$(database)/documents/groups/$(groupId)/events/$(eventId)).data.participantIds;
          }
          allow read: if isGroupMemberForModule();
          allow write: if isEventParticipantForModule();

          // Nested subcollections (e.g., sub_groups/{sgId}/members/{memberId})
          match /{nestedCol}/{nestedDocId} {
            allow read: if isGroupMemberForModule();
            allow write: if isEventParticipantForModule();
          }
        }
      }

      // Members subcollection -- explicit rules with role-lock on updates
      match /members/{memberId} {
        function isGroupMemberForMembers() {
          return request.auth != null &&
            request.auth.uid in
              get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }
        allow read: if isGroupMemberForMembers();
        allow create: if isGroupMemberForMembers();
        // Lock role field on updates -- prevents MEMBER -> CREATOR escalation
        allow update: if isGroupMemberForMembers()
          && request.resource.data.role == resource.data.role;
        allow delete: if isGroupMemberForMembers();
      }

      // Activity subcollection -- append-only (no updates or deletes)
      match /activity/{activityId} {
        function isGroupMemberForActivity() {
          return request.auth != null &&
            request.auth.uid in
              get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }
        allow read: if isGroupMemberForActivity();
        allow create: if isGroupMemberForActivity();
        // Activity logs are append-only (no updates or deletes)
        allow update, delete: if false;
      }

      // Settlements subcollection
      match /settlements/{settlementId} {
        function isGroupMemberForSettlements() {
          return request.auth != null &&
            request.auth.uid in
              get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        }
        allow read, write: if isGroupMemberForSettlements();
      }
    }
  }
}
