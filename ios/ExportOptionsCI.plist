<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CI variant of ExportOptions.plist: MANUAL signing with the
	     match-managed distribution cert + profile (rihla-ios-certs repo).
	     The local ExportOptions.plist stays automatic (Xcode account);
	     this one is consumed only by the `ios ci_beta` lane, whose
	     update_code_signing_settings step flips the project to manual on
	     the runner before the build. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>T2U886CPS5</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.nalbusaidi.rihla</key>
		<string>match AppStore com.nalbusaidi.rihla</string>
	</dict>
	<key>uploadBitcode</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
