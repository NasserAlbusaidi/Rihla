<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Wire the debug-only network security config (this dir's res/xml) so
         cleartext HTTP to the local Firebase emulator suite (10.0.2.2 / localhost)
         is permitted on debug builds. The config file existed but was referenced
         by no manifest, so the policy never applied and emulator traffic was
         blocked ("Cleartext HTTP traffic to 10.0.2.2 not permitted"). Debug-only;
         absent from release AABs. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
